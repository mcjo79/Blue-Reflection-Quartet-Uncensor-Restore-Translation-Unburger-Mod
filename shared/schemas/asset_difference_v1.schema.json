{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "br_asset_difference_v1.schema.json",
  "title": "Blue Reflection asset difference report v1",
  "type": "object",
  "required": [
    "type",
    "format_version",
    "source_target",
    "target_target",
    "entries"
  ],
  "properties": {
    "type": {
      "const": "br_asset_difference_report"
    },
    "format_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "difference_id",
          "classification",
          "normalized_path",
          "source",
          "target",
          "binary_similarity",
          "review_classification"
        ]
      }
    }
  }
}
