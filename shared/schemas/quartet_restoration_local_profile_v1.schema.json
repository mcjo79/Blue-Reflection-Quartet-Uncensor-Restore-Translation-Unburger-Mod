{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unburger.local/schemas/quartet_restoration_local_profile_v1.schema.json",
  "title": "Blue Reflection Quartet restoration local profile manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "target_relative_path",
    "baseline_sha256",
    "baseline_size",
    "profile_sha256",
    "profile_size",
    "local_profile_path",
    "changed_member_count",
    "changed_members",
    "runtime_validated",
    "workstream_id",
    "workstream_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "target_relative_path": {
      "enum": [
        "Data/PACK11.PAK",
        "Data/PACK10_01.PAK"
      ]
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_size": {
      "type": "integer",
      "minimum": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_size": {
      "type": "integer",
      "minimum": 1
    },
    "local_profile_path": {
      "type": "string",
      "pattern": "^\\.local/build/quartet_restoration/.+"
    },
    "changed_member_count": {
      "type": "integer",
      "minimum": 0
    },
    "changed_members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime_validated": {
      "type": "boolean"
    },
    "workstream_id": {
      "const": "quartet_restoration"
    },
    "workstream_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
