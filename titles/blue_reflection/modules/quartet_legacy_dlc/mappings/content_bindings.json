    "text_and_scene_inventory_is_complete_catalog": false,
    "nonscenario_discovery_source": "full BR1 asset inventories and JP system-table records",
    "fallback_asset_from_br1_allowed": true,
    "fallback_requires_explicit_documentation_and_validation": true,
    "technical_registry_discovery_source": "complete BR1 system tables, flags, system records and asset-member inventories",
    "technical_registry_requires_text_seed": false
  },
  "bindings": [
    {
      "binding_id": "legacy_dlc_south_island_family",
      "family_id": "south_island",
      "source_scope": "fe01_200-fe01_290 and fe03_210-fe14_270",
      "target_scope": "Blue Reflection Quartet",
      "status": "metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_ffxv_family",
      "family_id": "ffxv",
      "source_scope": "fe08_150-fe08_180",
      "target_scope": "Blue Reflection Quartet",
      "status": "metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_yy_family",
      "family_id": "yy",
      "source_scope": "yy01-yy04",
      "target_scope": "Blue Reflection Quartet",
      "status": "metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_system_registry",
      "family_id": "system_registry",
      "source_scope": "str_chat_msg.xml and str_costume.xml",
      "target_scope": "Blue Reflection Quartet",
      "status": "shared_dependency_audit"
    },
    {
      "binding_id": "legacy_dlc_costume_and_appearance_catalog",
      "family_id": "costume_and_appearance",
      "source_scope": "costumes, swimwear, towels, collaboration outfits, accessories and appearance variants discovered from BR1 members and tables",
      "target_scope": "Blue Reflection Quartet",
      "status": "independent_metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_items_rewards_and_recipes_catalog",
      "family_id": "items_rewards_and_recipes",
      "source_scope": "DLC item, reward, recipe, equipment and availability records discovered from BR1 tables",
      "target_scope": "Blue Reflection Quartet",
      "status": "independent_metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_theme_ui_and_freespace_catalog",
      "family_id": "theme_ui_and_freespace",
      "source_scope": "themes, FreeSpace skins, icons, descriptions and installation/system records",
      "target_scope": "Blue Reflection Quartet",
      "status": "independent_metadata_audit"
    },
    {
      "binding_id": "legacy_dlc_entitlement_and_unlock_catalog",
      "family_id": "entitlement_and_unlock",
      "source_scope": "DLC flags, entitlement identifiers, release conditions and availability records",
      "target_scope": "Blue Reflection Quartet",
      "status": "dependency_audit"
    },
    {
      "binding_id": "legacy_dlc_nonscenario_member_closure",
      "family_id": "nonscenario_member_closure",
      "source_scope": "table record, unlock flag, model, texture, material, physics, icon, description and optional event links",
