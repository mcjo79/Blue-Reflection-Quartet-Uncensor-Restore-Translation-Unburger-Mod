    {
      "index": 19,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801111",
      "string_no": "3801111",
      "string_id": null,
      "attributes": {
        "String_No": "3801111"
      },
      "jp": "「マルグリットさんの八百屋さん！^00　いつでも美味しそうなお野菜が置いてあって、^00　覗くとついお腹が空いちゃうんだ。^00　朝採れたてのお野菜は特に絶品だよ！」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 19,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 19,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
