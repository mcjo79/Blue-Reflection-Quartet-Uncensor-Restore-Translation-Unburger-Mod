    },
    {
      "index": 20,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801112",
      "string_no": "3801112",
      "string_id": null,
      "attributes": {
        "String_No": "3801112"
      },
      "jp": "「ロジーさんがやってる鍛冶屋さん。^00　金属を熱して溶かすための炉があるから、^00　いつ行ってもすっごい暑いんだ。^00　こっちが溶けそうになっちゃうくらい」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 20,
