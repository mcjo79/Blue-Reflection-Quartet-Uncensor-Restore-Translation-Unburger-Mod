    {
      "index": 13,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801105",
      "string_no": "3801105",
      "string_id": null,
      "attributes": {
        "String_No": "3801105"
      },
      "jp": "「言うまでもなく、あたしのアトリエ！^00　いつもお客さんでいっぱいの大繁盛のお店…^00　を目指してはいるんだけど、^00　なかなかそうはいかないんだよね…」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 13,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 13,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
          "blue_reflection_original": 13,
          "blue_reflection_quartet": 13
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 14,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801106",
      "string_no": "3801106",
      "string_id": null,
      "attributes": {
        "String_No": "3801106"
      },
      "jp": "「キルヘン・ベルの街の入り口だね。^00　この街はあんまり大きくないけど、^00　観光目当てのお客さんとか冒険者の人、あと^00　行商人なんかも来るから、人は多いんだよ」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 14,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 14,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
          "blue_reflection_original": 14,
          "blue_reflection_quartet": 14
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 15,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801107",
      "string_no": "3801107",
      "string_id": null,
      "attributes": {
        "String_No": "3801107"
      },
      "jp": "「教会に面してる大きな広場だよ。^00　ちょっとお洒落な感じの噴水が目印かな。^00　お花も植えてあるから、ベンチに座って^00　のんびりするのも悪くないよ」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 15,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 15,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
          "blue_reflection_original": 15,
          "blue_reflection_quartet": 15
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 16,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801108",
      "string_no": "3801108",
      "string_id": null,
      "attributes": {
        "String_No": "3801108"
      },
      "jp": "「街一番の観光名所になってる教会。^00　パメラがシスターをやってるんだ。^00　本当の名前は『ヴァルム教会』って言って、^00　鐘の音は街のどこにいても聞こえるんだよ」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 16,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 16,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
          "blue_reflection_original": 16,
          "blue_reflection_quartet": 16
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 17,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801109",
      "string_no": "3801109",
      "string_id": null,
      "attributes": {
        "String_No": "3801109"
      },
      "jp": "「色んなお店が並んでる、街の大通り。^00　街で一番賑やかな場所で、欲しい物は^00　ここに来れば大体揃うよ。…誘惑も多いから、^00　余計な物を買わないようにしないと」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 17,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 17,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
          "blue_reflection_original": 17,
          "blue_reflection_quartet": 17
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 18,
      "logical_id": "blue_reflection:system:str_library_build.xml:String_No:3801110",
      "string_no": "3801110",
      "string_id": null,
      "attributes": {
        "String_No": "3801110"
      },
      "jp": "「ホルストさんがやってるカフェだね。^00　ここのお茶とお菓子はとっても美味しいの！^00　お客さんの中には、ホルストさんのお話を^00　聞きに来る人も多いみたい」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 18,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 18,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
