          "blue_reflection_quartet": 29
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 30,
      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735583",
      "string_no": "3735583",
      "string_id": null,
      "attributes": {
        "String_No": "3735583"
      },
      "jp": "「すっごく静かな湖だよ。^00　聞こえてくるのは水の音と木の葉がこすれる^00　音、あと魔物の鳴き声だけ…」^00「なぁ。それ…静かなのか？」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 30,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 30,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
