      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735572",
      "string_no": "3735572",
      "string_id": null,
      "attributes": {
        "String_No": "3735572"
      },
      "jp": "「ちょっとじめじめした感じの森だよね。^00　生えてるキノコって食べられるのかな」^00「オイラもキノコにはそこまで詳しくないから^00　なぁ。やめておいた方が良いんじゃないか？」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 19,
