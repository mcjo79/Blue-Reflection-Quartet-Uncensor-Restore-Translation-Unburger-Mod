    {
      "index": 29,
      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735582",
      "string_no": "3735582",
      "string_id": null,
      "attributes": {
        "String_No": "3735582"
      },
      "jp": "「湖の畔だね。頑張ったら、近くに見える^00　小島まで行けたりしないかな？」^00「泳げば行けなくはないだろうけど…^00　そこまでする意味あるか？」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 29,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 29,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
