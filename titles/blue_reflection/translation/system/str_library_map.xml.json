          "blue_reflection_quartet": 31
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 32,
      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735585",
      "string_no": "3735585",
      "string_id": null,
      "attributes": {
        "String_No": "3735585"
      },
      "jp": "「池の中に浮かぶ小島がある場所だね。^00　ちゃんと橋がかかってるから、^00　渡ることもできるよ」^00「小さい島だから、足を滑らせないようにね？」",
