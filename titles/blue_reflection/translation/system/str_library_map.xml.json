        }
      }
    },
    {
      "index": 36,
      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735589",
      "string_no": "3735589",
      "string_id": null,
      "attributes": {
        "String_No": "3735589"
      },
      "jp": "「山間の砂地だね。枯れ木がちょっと目立って^00　かわいそうかも…」^00「…土が痩せてて過酷な場所みたいだな。^00　できれば植え替えてやりたいとこだけど…」",
      "en_original": "",
      "en_auxiliary": "",
      "en": "",
      "alignment": {
        "status": "exact_string_no",
        "initial_en_source": "official_en",
        "official_en_index": 36,
        "official_en_mapping": "exact_string_no",
        "auxiliary_en_index": 36,
        "auxiliary_mapping": "exact_string_no+exact_string_no",
        "target_indices": {
