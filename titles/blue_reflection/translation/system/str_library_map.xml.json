          "blue_reflection_quartet": 30
        },
        "target_mapping": {
          "blue_reflection_original": "exact_string_no",
          "blue_reflection_quartet": "exact_string_no"
        }
      }
    },
    {
      "index": 31,
      "logical_id": "blue_reflection:system:str_library_map.xml:String_No:3735584",
      "string_no": "3735584",
      "string_id": null,
      "attributes": {
        "String_No": "3735584"
      },
      "jp": "「ここは釣りの名所なんだそうよ。^00　糸を垂らすとすぐに魚がかかるんですって」^00「へぇ…。あたし、釣りってやったことない^00　んだよね。試しにやってみようかな…」",
