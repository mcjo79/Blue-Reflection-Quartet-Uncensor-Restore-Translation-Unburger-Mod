 file="event_en/om08/event_message_om08_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om09"><event file="event_en/om09/event_message_om09_010.ebm"><message msg_id="0" name_id="91">...Sirius, l'étoile la plus brillante du ciel nocturne.</message><message msg_id="1" name_id="55">Oh ? Qu'est-ce que c'est ? Tu regardes un guide des constellations ?</message><message msg_id="2" name_id="91">Ah, euh...</message><message msg_id="3" name_id="55">Ca me rappelle des souvenirs. Je t'ai acheté ca&lt;CR&gt;quand tu étais petite.</message><message msg_id="4" name_id="55">Tu ne t'y intéressais pas du tout a l'époque.&lt;CR&gt;Pourquoi cet intéret soudain ?</message><message msg_id="5" name_id="91">Eh bien, je cherche quelque chose...&lt;CR&gt;Ou peut-etre que je me prépare au combat ?</message><message msg_id="6" name_id="55">C-contre quoi comptes-tu te battre ?</message><message msg_id="7" name_id="91">Secret !</message></event><event file="event_en/om09/event_message_om09_020.ebm"><message msg_id="0" name_id="89">Hé, hé, je veux aller a la peche aux poissons rouges !</message><message msg_id="1" name_id="93">Mais on ne peut pas en garder un a la maison, pas vrai ?</message><message msg_id="2" name_id="56">Eh bien, si tu promets de bien t'en occuper,&lt;CR&gt;tu peux en garder un.</message><message msg_id="3" name_id="89">Vraiment ?! Oui, oui ! Je vais bien m'en occuper !</message><message msg_id="4" name_id="93">...Alors je vais aider aussi.</message><message msg_id="5" name_id="89">Youpi ! Merci, grande soeur !</message><message msg_id="6" name_id="56">Hé hé. Avec grande soeur pour aider, je sais que tout ira bien.</message></event><event file="event_en/om09/event_message_om09_030.ebm"><message msg_id="0" name_id="92">...</message><message msg_id="1" name_id="56">Tu as bien joué.&lt;CR&gt;Mais ce serait encore mieux si tu y mettais un peu plus de sentiment.</message><message msg_id="2" name_id="92">Du sentiment...</message><message msg_id="3" name_id="92">Quel genre de sentiment devrais-je y mettre ?</message><message msg_id="4" name_id="56">C'est un morceau qui parle de penser a sa famille...&lt;CR&gt;Peut-etre de la gratitude envers tes parents.</message><message msg_id="5" name_id="92">De la gratitude...</message><message msg_id="6" name_id="92">Je ne comprends pas vraiment, mais je vais faire de mon mieux.</message></event><event file="event_en/om09/event_message_om09_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_090.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_100.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_110.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_130.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om09/event_message_om09_160.ebm"><message msg_id="42