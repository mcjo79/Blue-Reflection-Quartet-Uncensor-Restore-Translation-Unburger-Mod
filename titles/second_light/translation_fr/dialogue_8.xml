<translation game="second_light" lang="fr"><meta release="BRSL beta dialogue + machine translation" /><dialogue><chapter id="om07"><event file="event_en/om07/event_message_om07_010.ebm"><message msg_id="0" name_id="93">*Halete*... *halete*...</message><message msg_id="1" name_id="89">Ahaha, Onee-chan, tu n'as aucune endurance !</message><message msg_id="2" name_id="93">C'est plutot toi qui en as beaucoup trop...</message><message msg_id="3" name_id="93">J'y mettais pourtant toute mon énergie moi aussi...&lt;CR&gt;On aurait dit que tu allais nager tres loin au large...</message><message msg_id="4" name_id="89">Si j'en avais envie, je pourrais nager jusqu'a cette ile !</message><message msg_id="5" name_id="93">C'est justement pour ca que je te dis de ne pas le faire...</message></event><event file="event_en/om07/event_message_om07_020.ebm"><message msg_id="0" name_id="90">Oh, je suis désolée. Nous sommes fermés pour le moment.</message><message msg_id="1" name_id="86">Hein ? Oh, je vois.&lt;CR&gt;Mais l'enseigne indique OUVERT...</message><message msg_id="2" name_id="90">Quoi ?! Je... je suis désolée. J'ai oublié de la rentrer.</message><message msg_id="3" name_id="86">Tu travailles ici ?</message><message msg_id="4" name_id="90">Oui. Mon pere tient la boutique...&lt;CR&gt;mais il vient juste de sortir.</message><message msg_id="5" name_id="86">Je vois. C'est pour ca que la boutique est fermée.</message><message msg_id="6" name_id="90">Oui. Il a dit qu'il avait quelque chose d'urgent.&lt;CR&gt;Franchement, il n'en fait qu'a sa tete.</message><message msg_id="7" name_id="86">Ca te dérangerait si j'attendais ici&lt;CR&gt;jusqu'au retour de ton pere ?</message><message msg_id="8" name_id="90">Hein ? Bien sur... ca ne me dérange pas,&lt;CR&gt;mais je ne sais pas quand il reviendra.</message><message msg_id="9" name_id="86">C'est parfait.</message></event><event file="event_en/om07/event_message_om07_030.ebm"><message msg_id="0" name_id="92">Qu'est-ce que tu penses de moi ?</message><message msg_id="1" name_id="92">...</message><message msg_id="2" name_id="92">Je suppose que tu ne vas pas me répondre.</message><message msg_id="3" name_id="92">...Si doux...</message></event><event file="event_en/om07/event_message_om07_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_090.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_100.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_110.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_130.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_170.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/even