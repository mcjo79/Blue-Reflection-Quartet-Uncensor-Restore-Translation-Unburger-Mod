4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_820.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_830.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_840.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_850.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_860.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_870.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_880.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_890.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_900.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_910.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_920.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_930.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_940.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_950.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_960.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_970.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_980.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om07/event_message_om07_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om08"><event file="event_en/om08/event_message_om08_010.ebm"><message msg_id="0" name_id="95">Hé, et si on rejoignait un club ensemble ?</message><message msg_id="1" name_id="93">Désolée. J'ai des choses a gérer a la maison...</message><message msg_id="2" name_id="95">Tu vis seule avec ta petite soeur, non ?&lt;CR&gt;C'est dur ?</message><message msg_id="3" name_id="93">Ca peut l'etre. Mais je le fais pour ma soeur...</message></event><event file="event_en/om08/event_message_om08_020.ebm"><message msg_id="0" name_id="91">Oh ! Quel hasard de te croiser ici !</message><message msg_id="1" name_id="88">Argh.</message><message msg_id="2" name_id="91">Comment ca, " argh " ?</message><message msg_id="3" name_id="88">Qu'est-ce que tu fais ici ?</message><message msg_id="4" name_id="91">Pourquoi d'autre viendrais-je dans une librairie&lt;CR&gt;a part pour acheter un livre ?</message><message msg_id="5" name_id="91">Hé, qu'est-ce que tu as acheté ?</message><message msg_id="6" name_id="88">...C'est un secret.</message><message msg_id="7" name_id="91">Quoii ?! Maintenant je suis curieuse !&lt;CR&gt;Qu'est-ce que tu as acheté ?</message><message msg_id="8" name_id="88">Je suis pressée, alors salut !</message></event><event file="event_en/om08/event_message_om08_030.ebm"><message msg_id="0" name_id="59">Alors tu pars vraiment...</message><message msg_id="1" name_id="94">Je suis désolée.&lt;CR&gt;Mais on dirait qu'il n'y a plus de place pour moi ici...</message><message msg_id="2" name_id="59">...Je suis désolée. C'est ma faute.</message><message msg_id="3" name_id="94">Pas besoin de te sentir responsable.&lt;CR&gt;C'était la décision de --.</message><message msg_id="4" name_id="94">Adios, amigo.</message></event><event file="event_en/om08/event_message_om08_040.ebm"><message msg_id="0" name_id="3">(Aucune des boissons ne semble jamais s'épuiser.&lt;CR&gt;Elles devraient pourtant commencer a manquer...)</message></event><event file="event_en/om08/event_message_om08_050.ebm"><message msg_id="0" name_id="3">(Les portraits des anciens directeurs dans le bureau du directeur&lt;CR&gt;se mettent soudain a bouger... Non, c'était dans la salle de musique ?)</message></event><event file="event_en/om08/event_message_om08_060.ebm"><message msg_id="0" name_id="3">(Avec le portail de l'école grand ouvert comme ca,&lt;CR&gt;j'ai tellement envie de foncer dehors. Zooooom !)</message></event><event file="event_en/om08/event_message_om08_070.ebm"><message msg_id="0" name_id="3">(Les hortensias n'ont toujours pas fané aujourd'hui.&lt;CR&gt;Je suppose que les choses poussent a un rythme différent ici... Ou alors elles ne poussent pas du tout ?)</message></event><event file="event_en/om08/event_message_om08_080.ebm"><message msg_id="0" name_id="3">(En regardant encore ces casiers a chaussures, il n'y en a vraiment pas beaucoup.&lt;CR&gt;Ca devait etre un peu différent d'une école ordinaire.)</message></event><event file="event_en/om08/event_message_om08_090.ebm"><message msg_id="0" name_id="3">(Depuis que Mio-san a rejoint l'équipe de cuisine,&lt;CR&gt;j'ai l'impression que la cuisine est devenue encore plus propre.)</message></event><event file="event_en/om08/event_message_om08_100.ebm"><message msg_id="0" name_id="3">(Avant, je pensais vouloir un trophée a moi comme ceux-la un jour...&lt;CR&gt;Mais avoir tout le monde me suffit.)</message></event><event file="event_en/om08/event_message_om08_110.ebm"><message msg_id="0" name_id="3">(En y repensant, Uta-san était curieuse.&lt;CR&gt;Elle se demandait ce qu'il y avait dans cette salle des écrivains.)</message></event><event file="event_en/om08/event_message_om08_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_130.ebm"><message msg_id="0" name_id="3">(Hein ? Pendant une seconde, j'ai vu la silhouette de quelqu'un...&lt;CR&gt;Non, c'était mon imagination. Ca m'a fait peur...)</message></event><event file="event_en/om08/event_message_om08_140.ebm"><message msg_id="0" name_id="3">(Peut-etre que c'est le désir de tout le monde de rester hors de cette piece&lt;CR&gt;qui garde la salle des professeurs verrouillée.)</message></event><event file="event_en/om08/event_message_om08_150.ebm"><message msg_id="0" name_id="3">(Comment fait-on pour passer derriere ce comptoir ?&lt;CR&gt;Je demanderai a Kirara la prochaine fois.)</message></event><event file="event_en/om08/event_message_om08_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_170.ebm"><message msg_id="0" name_id="3">(On a une regle contre le fait de laisser des affaires personnelles ici&lt;CR&gt;pour que ca ne s'encombre pas... meme si je laisse souvent les miennes trainer.)</message></event><event file="event_en/om08/event_message_om08_180.ebm"><message msg_id="0" name_id="3">(La serviette que j'ai oubliée ici l'autre jour a disparu.&lt;CR&gt;Je me demande qui l'a prise...)</message></event><event file="event_en/om08/event_message_om08_190.ebm"><message msg_id="0" name_id="3">(Ce schéma est plutot réussi.&lt;CR&gt;Je pense qu'il a été dessiné a main levée, en plus.)</message></event><event file="event_en/om08/event_message_om08_200.ebm"><message msg_id="0" name_id="3">(Une serviette fraiche... Ca pourrait marcher.&lt;CR&gt;J'essaierai la prochaine fois.)</message></event><event file="event_en/om08/event_message_om08_210.ebm"><message msg_id="0" name_id="3">(L'autre soir, j'ai vu une silhouette se glisser dans l'infirmerie.&lt;CR&gt;Elle voulait probablement utiliser la piece en secret.)</message></event><event file="event_en/om08/event_message_om08_220.ebm"><message msg_id="0" name_id="3">(Cet ordinateur a l'air assez utile&lt;CR&gt;pour laisser des notes, au moins.)</message></event><event file="event_en/om08/event_message_om08_230.ebm"><message msg_id="0" name_id="3">(Personne ne me trouverait si je me cachais dans le plinth...&lt;CR&gt;Peut-etre que je pourrais faire jouer tout le monde a cache-cache.)</message></event><event file="event_en/om08/event_message_om08_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_250.ebm"><message msg_id="0" name_id="3">(Kirara a failli etre bannie d'ici&lt;CR&gt;pour avoir essayé de communiquer avec l'espace.)</message></event><event file="event_en/om08/event_message_om08_260.ebm"><message msg_id="0" name_id="3">(L'une des filles qui sont venues ici&lt;CR&gt;aurait-elle vraiment été en classe 2-A ? Je demanderai un de ces jours.)</message></event><event file="event_en/om08/event_message_om08_270.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_280.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_290.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_300.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_310.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_320.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_330.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_340.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om08/event_message_om08_350.ebm"><message msg_id