<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE translation SYSTEM "../../../Blue_Reflection_Text_Tool/translation_fr.dtd">
<translation game="second_light" lang="fr"><meta release="BRSL beta dialogue + machine translation" /><dialogue><chapter id="om04"><event file="event_en/om04/event_message_om04_010.ebm"><message msg_id="0" name_id="90">*Renifle*... *sanglote*...</message><message msg_id="1" name_id="55">...La, la.&lt;CR&gt;Je suis désolée. C'était dur de dire au revoir a ton amie, n'est-ce pas ?</message><message msg_id="2" name_id="56">Tu ne peux pas pleurer éternellement.&lt;CR&gt;Sinon, cette fille va se moquer de toi.</message><message msg_id="3" name_id="90">*Renifle*... D'accord...&lt;CR&gt;Meme si nous sommes séparées... nous restons amies...</message><message msg_id="4" name_id="55">C'est ca. Vous vous reverrez un jour,&lt;CR&gt;tant que vous continuerez a penser l'une a l'autre.</message></event><event file="event_en/om04/event_message_om04_020.ebm"><message msg_id="0" name_id="95">Une éleve transférée en cours d'année ! Une aura mystérieuse et des relations mystérieuses !&lt;CR&gt;Mon instinct de journaliste me dit quelque chose !</message><message msg_id="1" name_id="95">Tu es un agent de quelque pays, une extraterrestre,&lt;CR&gt;ou peut-etre meme une héroine qui se transforme !</message><message msg_id="2" name_id="86">...Je ne suis pas une éleve transférée, tu sais ?</message><message msg_id="3" name_id="95">Hein ?</message><message msg_id="4" name_id="86">C'est juste que je n'ai pas pu venir jusqu'a récemment a cause de certaines circonstances.&lt;CR&gt;Je suis inscrite dans cette école depuis le début.</message><message msg_id="5" name_id="95">Pas possible... Je pensais avoir enfin trouvé un sujet...</message></event><event file="event_en/om04/event_message_om04_030.ebm"><message msg_id="0" name_id="91">Ouah, c'est quoi ca ? Ce phare est immense...</message><message msg_id="1" name_id="55">Apparemment, c'est un site touristique célebre par ici.&lt;CR&gt;Tu veux qu'on aille voir ca plus tard ?</message><message msg_id="2" name_id="91">Hmm, mais vous deux, vous devez défaire vos valises, non ?&lt;CR&gt;J'irai toute seule.</message><message msg_id="3" name_id="56">Hé, n'essaie pas d'etre la seule a te défiler.</message><message msg_id="4" name_id="91">Roooh. Je sais, je sais.</message></event><event file="event_en/om04/event_message_om04_040.ebm"><message msg_id="0" name_id="3">(Le choix dans ce distributeur automatique semble parfois changer.&lt;CR&gt;...P-peut-etre que je me fais des idées.)</message></event><event file="event_en/om04/event_message_om04_050.ebm"><message msg_id="0" name_id="3">(Le directeur de cette école est peut-etre une femme ?&lt;CR&gt;Je veux dire, il n'y a que des toilettes pour filles ici.)</message><message msg_id="1" name_id="3">(Non, il doit bien y avoir des toilettes séparées pour le personnel. Sans doute.)</message></event><event file="event_en/om04/event_message_om04_060.ebm"><message msg_id="0" name_id="3">(La route est défoncée...&lt;CR&gt;Je me demande si elle continuait au-dela d'ici autrefois.)</message></event><event file="event_en/om04/event_message_om04_070.ebm"><message msg_id="0" name_id="3">(Quelqu'un s'occupe de ces arbustes ?&lt;CR&gt;Ils sont toujours soigneusement taillés.)</message></event><event file="event_en/om04/event_message_om04_080.ebm"><message msg_id="0" name_id="3">(Yuki a dit qu'ouvrir et fermer ces casiers a chaussures dans un certain ordre&lt;CR&gt;menerait a un Heartscape spécial.)</message><message msg_id="1" name_id="3">(...Ouais, c'est ca.)</message></event><event file="event_en/om04/event_message_om04_090.ebm"><message msg_id="0" name_id="3">(Cette bouteille élégante ne pouvait pas etre...&lt;CR&gt;Oh, elle est remplie d'huile d'olive.)</message></event><event file="event_en/om04/event_message_om04_100.ebm"><message msg_id="0" name_id="3">(Ce serait peut-etre amusant de créer nos propres récompenses aussi.&lt;CR&gt;Comme un " Prix de la lessive faite avec beaucoup d'efforts " !)</message></event><event file="event_en/om04/event_message_om04_110.ebm"><message msg_id="0" name_id="3">(Une piece qui ne s'ouvre jamais est un peu effrayante aussi.&lt;CR&gt;Je pourrais enfoncer la porte-non, mieux vaut pas. J'aurais des ennuis.)</message></event><event file="event_en/om04/event_message_om04_120.ebm"><message msg_id="0" name_id="3">(De plus en plus de gens nous rejoignent petit a petit.&lt;CR&gt;Il est peut-etre temps qu'on commence a utiliser cette piece.)</message></event><event file="event_en/om04/event_message_om04_130.ebm"><message msg_id="0" name_id="3">(Je fais attention a venir accompagnée quand je viens ici la nuit.&lt;CR&gt;C'est un peu effrayant, apres tout.)</message></event><event file="event_en/om04/event_message_om04_140.ebm"><message msg_id="0" name_id="3">(...Je me demande ce que mon professeur principal et tous les éleves de ma classe&lt;CR&gt;font en ce moment.)</message></event><event file="event_en/om04/event_message_om04_150.ebm"><message msg_id="0" name_id="3">(A quoi sert le bureau au fond ?&lt;CR&gt;Ca a l'air d'un bon endroit pour travailler un peu.)</message></event><event file="event_en/om04/event_message_om04_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_170.ebm"><message msg_id="0" name_id="3">(Hein ? Est-ce que j'ai un peu bronzé ?&lt;CR&gt;Je devrais vraiment mettre de la creme solaire...)</message></event><event file="event_en/om04/event_message_om04_180.ebm"><message msg_id="0" name_id="3">(Classement des gens qui laissent des affaires dans leurs casiers.&lt;CR&gt;Troisieme : Kokoro. Deuxieme : moi... Et Yuki est premiere, et de loin.)</message></event><event file="event_en/om04/event_message_om04_190.ebm"><message msg_id="0" name_id="3">(Depuis que Shiho-san est arrivée, le " MENU DU CAFE "&lt;CR&gt;est devenu réel. Et notre menu est encore plus grand que ca.)</message></event><event file="event_en/om04/event_message_om04_200.ebm"><message msg_id="0" name_id="3">(Je sais que Yuki cache ses propres snacks&lt;CR&gt;dans ce réfrigérateur.)</message><message msg_id="1" name_id="3">(...Bon, je vais laisser passer pour aujourd'hui.)</message></event><event file="event_en/om04/event_message_om04_210.ebm"><message msg_id="0" name_id="3">(Je me demande si j'ai fini de grandir.&lt;CR&gt;Pourtant, je dors beaucoup.)</message></event><event file="event_en/om04/event_message_om04_220.ebm"><message msg_id="0" name_id="3">(Chaque fois que j'utilise cet ordinateur, j'oublie qu'il y a une imprimante en dessous&lt;CR&gt;et je finis par lui donner des coups de pied.)</message><message msg_id="1" name_id="3">(Rena-san me gronderait si elle l'apprenait...&lt;CR&gt;Je devrais faire attention.)</message></event><event file="event_en/om04/event_message_om04_230.ebm"><message msg_id="0" name_id="3">(L'autre jour, j'ai sorti un ballon de basket pour jouer,&lt;CR&gt;mais il est tombé dans la mer et a dérivé quelque part...)</message></event><event file="event_en/om04/event_message_om04_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_250.ebm"><message msg_id="0" name_id="3">(Qu'est-ce que je devrais passer a la prochaine émission de l'école ?&lt;CR&gt;Parler des événements récents, ou opter pour quelque chose de drole... ?)</message></event><event file="event_en/om04/event_message_om04_260.ebm"><message msg_id="0" name_id="3">(Peut-etre que les clés des pieces verrouillées sont quelque part par ici&lt;CR&gt;et qu'on ne les a simplement pas encore trouvées ?)</message></event><event file="event_en/om04/event_message_om04_270.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_280.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_290.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_300.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_310.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_320.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_330.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_340.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_350.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_360.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_370.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_380.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_390.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_400.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_410.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_420.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_430.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_440.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_450.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_460.ebm"><message msg_id="4