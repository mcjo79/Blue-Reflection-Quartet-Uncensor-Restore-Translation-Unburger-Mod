om04_780.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_790.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_800.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_810.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_820.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_830.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_840.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_850.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_860.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_870.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_880.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_890.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_900.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_910.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_920.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_930.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_940.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_950.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_960.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_970.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_980.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om04/event_message_om04_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om05"><event file="event_en/om05/event_message_om05_010.ebm"><message msg_id="0" name_id="95">Je crois que meme si nous perdons nos souvenirs,&lt;CR&gt;nous redeviendrons proches, comme maintenant.</message><message msg_id="1" name_id="95">Et -- pourra briller a nouveau comme ca.&lt;CR&gt;Tu peux devenir une étoile.</message><message msg_id="2" name_id="95">Mais fais attention a ne rien faire que tu regretterais.</message><message msg_id="3" name_id="86">Ouais... Merci, --.</message></event><event file="event_en/om05/event_message_om05_020.ebm"><message msg_id="0" name_id="87">...J'ai réussi. Je les ai tous touchés.</message><message msg_id="1" name_id="55">Argh ! Je n'arrive pas a te battre !</message><message msg_id="2" name_id="87">Monsieur, laissez-moi réessayer...</message><message msg_id="3" name_id="55">Désolé ! Si tu gagnes encore des lots, je vais faire faillite !&lt;CR&gt;On s'arrete la pour aujourd'hui !</message><message msg_id="4" name_id="55">La prochaine fois, je te préparerai quelque chose d'encore plus incroyable.</message><message msg_id="5" name_id="87">D'accord... Je reviendrai.</message></event><event file="event_en/om05/event_message_om05_030.ebm"><message msg_id="0" name_id="90">---san, tu veux rentrer ensemble a pied ?&lt;CR&gt;Attends, c'est quoi ce... baton ?</message><message msg_id="1" name_id="94">Ce n'est pas un baton ordinaire. C'est un totem vénérable.&lt;CR&gt;Un des trésors de ma collection.</message><message msg_id="2" name_id="90">Un totem... Oh, un mat totémique.&lt;CR&gt;Pourquoi tu collectionnes ce genre de choses ?</message><message msg_id="3" name_id="94">Si je devais le résumer en un mot... le romantisme.</message><message msg_id="4" name_id="90">Le romantisme...</message></event><event file="event_en/om05/event_message_om05_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_090.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_100.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_110.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_130.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁<