_790.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_800.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_810.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_820.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_830.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_840.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_850.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_860.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_870.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_880.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_890.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_900.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_910.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_920.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_930.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_940.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_950.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_960.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_970.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_980.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om05/event_message_om05_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om06"><event file="event_en/om06/event_message_om06_010.ebm"><message msg_id="0" name_id="90">Papa, apprends-moi a cuisiner !</message><message msg_id="1" name_id="55">Oh ? Qu'est-ce qui t'a pris tout d'un coup ?</message><message msg_id="2" name_id="90">J'ai promis de préparer un bon repas a une amie la prochaine fois,&lt;CR&gt;et...</message><message msg_id="3" name_id="90">Meme si je n'ai jamais cuisiné...</message><message msg_id="4" name_id="55">Haha, tu voulais montrer a ton amie ce dont tu es capable.&lt;CR&gt;D'accord, je vais tout t'apprendre !</message><message msg_id="5" name_id="90">Merci !</message></event><event file="event_en/om06/event_message_om06_020.ebm"><message msg_id="0" name_id="59">---chan, qu'est-ce que tu écris ?&lt;CR&gt;Une rédaction ?</message><message msg_id="1" name_id="94">Un peu comme... un roman.</message><message msg_id="2" name_id="59">Waouh, c'est génial ! Je peux le lire ?</message><message msg_id="3" name_id="94">Non, ce n'est pas encore pret a etre montré.&lt;CR&gt;Peut-etre un jour.</message><message msg_id="4" name_id="59">J'ai hate !</message></event><event file="event_en/om06/event_message_om06_030.ebm"><message msg_id="0" name_id="93">Bon, mélange bien ca.&lt;CR&gt;Fais attention a ce qu'il n'y ait pas de grumeaux...</message><message msg_id="1" name_id="89">D'accord !&lt;CR&gt;Hyaaaaaah !!</message><message msg_id="2" name_id="93">Hé, ne sois pas si brusque.&lt;CR&gt;Sois plus douce.</message><message msg_id="3" name_id="89">D'accoooord !&lt;CR&gt;Ho hisse, ho hisse.</message><message msg_id="4" name_id="93">Héhé, c'est ca.</message><message msg_id="5" name_id="89">Dis, grande soeur.&lt;CR&gt;Tu crois que maman sera contente ?</message><message msg_id="6" name_id="93">Oui. J'en suis sure.</message></event><event file="event_en/om06/event_message_om06_040.ebm"><message msg_id="0" name_id="3">(Il y a une boisson marquée d'un point d'interrogation.&lt;CR&gt;Ca veut dire qu'on peut voir laquelle sort ?)</message></event><event file="event_en/om06/event_message_om06_050.ebm"><message msg_id="0" name_id="3">(Honnetement, je suis sure de mieux connaitre cette école&lt;CR&gt;que son principal. J'y vis, apres tout.)</message></event><event file="event_en/om06/event_message_om06_060.ebm"><message msg_id="0" name_id="3">(Maintenant que j'y pense, mon école avait aussi un prof terrifiant&lt;CR&gt;qui sévissait contre les retards...)</message></event><event file="event_en/om06/event_message_om06_070.ebm"><message msg_id="0" name_id="3">(Il pleut aussi dans ce monde. Les fleurs poussent grace a ca.&lt;CR&gt;Mais... d'ou viennent les nuages ?)</message></event><event file="event_en/om06/event_message_om06_080.ebm"><message msg_id="0" name_id="3">(On se couvre parfois de boue dans le Heartscape,&lt;CR&gt;alors on devrait quand meme enfiler nos chaussures d'intérieur ?)</message><message msg_id="1" name_id="3">(...Bon, c'est un peu tard pour ca.)</message></event><event file="event_en/om06/event_message_om06_090.ebm"><message msg_id="0" name_id="3">(Dernierement, j'entends souvent Kirara gémir&lt;CR&gt;d'ici.)</message></event><event file="event_en/om06/event_message_om06_100.ebm"><message msg_id="0" name_id="3">(Il parait que Hinako-san a beaucoup de diplomes chez elle.&lt;CR&gt;J'aimerais avoir un talent spécial comme ca, moi aussi.)</message></event><event file="event_en/om06/event_message_om06_110.ebm"><message msg_id="0" name_id="3">(J'ai aussi demandé aux filles qui ont retrouvé leurs souvenirs,&lt;CR&gt;et apparemment, une salle des écrivains, c'est vraiment rare.)</message></event><event file="event_en/om06/event_message_om06_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_130.ebm"><message msg_id="0" name_id="3">(Ca sent toujours un peu bon ici,&lt;CR&gt;donc c'est agréable. Meme si ce sont des toilettes.)</message></event><event file="event_en/om06/event_message_om06_140.ebm"><message msg_id="0" name_id="3">(Et si un professeur arrivait comme nouvelle Reflector ?&lt;CR&gt;Ce serait un peu genant...)</message></event><event file="event_en/om06/event_message_om06_150.ebm"><message msg_id="0" name_id="3">(Kirara s'assoit parfois ici.&lt;CR&gt;Apparemment, ca la calme meme quand il n'y a rien a faire.)</message></event><event file="event_en/om06/event_message_om06_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_170.ebm"><message msg_id="0" name_id="3">(Est-ce que je devrais enlever mon bandeau ?&lt;CR&gt;...Non, c'est une touche finale importante !)</message></event><event file="event_en/om06/event_message_om06_180.ebm"><message msg_id="0" name_id="3">(Classement des personnes qui laissent des affaires dans leur casier.&lt;CR&gt;Dernierement, Kirara rattrape rapidement Yuki pour la premiere place.)</message></event><event file="event_en/om06/event_message_om06_190.ebm"><message msg_id="0" name_id="3">(Pourquoi y a-t-il un emploi du temps d'aout ici... ?&lt;CR&gt;Ca dit " Rassemblement !! " - mais ou ?)</message></event><event file="event_en/om06/event_message_om06_200.ebm"><message msg_id="0" name_id="3">(Certaines gardent aussi des gouttes pour les yeux ici.&lt;CR&gt;Des gouttes glacées, c'est parfait pour se réveiller.)</message></event><event file="event_en/om06/event_message_om06_210.ebm"><message msg_id="0" name_id="3">(J'ai l'impression d'avoir pris du poids dernierement.&lt;CR&gt;Je devrais vérifier ? Non, je ne veux pas affronter la réalité...)</message></event><event file="event_en/om06/event_message_om06_220.ebm"><message msg_id="0" name_id="3">(Peut-etre que je me suis habituée a le voir, mais le requin commence a avoir l'air mignon.)</message></event><event file="event_en/om06/event_message_om06_230.ebm"><message msg_id="0" name_id="3">(Ce ne serait pas génial de recouvrir le sol de la classe&lt;CR&gt;avec tous les tapis de la réserve ?)</message></event><event file="event_en/om06/event_message_om06_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_250.ebm"><message msg_id="0" name_id="3">(La salle de diffusion. Yuki a failli etre bannie&lt;CR&gt;parce qu'elle n'arretait pas de parler de ce qu'elle voulait.)</message></event><event file="event_en/om06/event_message_om06_260.ebm"><message msg_id="0" name_id="3">(Si les gens continuent d'arriver a ce rythme,&lt;CR&gt;on devra peut-etre ouvrir la 2-A aussi.)</message></event><event file="event_en/om06/event_message_om06_270.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_280.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_290.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_300.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_310.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_320.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om06/event_message_om06_330.ebm"><message msg_id="4294967295" name_id="42949672