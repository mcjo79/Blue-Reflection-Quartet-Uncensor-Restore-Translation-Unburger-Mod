<!DOCTYPE translation SYSTEM "../../../Blue_Reflection_Text_Tool/translation_fr.dtd">
<translation game="second_light" lang="fr"><meta release="BRSL beta dialogue + machine translation" /><dialogue><chapter id="om01"><event file="event_en/om01/event_message_om01_010.ebm"><message msg_id="0" name_id="87">――-chan, tu ne vas pas nager ?</message><message msg_id="1" name_id="90">Je ne sais pas nager...&lt;CR&gt;Ca me va tres bien de juste regarder d'ici.</message><message msg_id="2" name_id="87">Alors je vais peut-etre faire pareil.</message></event><event file="event_en/om01/event_message_om01_020.ebm"><message msg_id="0" name_id="98">Excusez-moi.&lt;CR&gt;On peut monter tout en haut depuis ici ?</message><message msg_id="1" name_id="88">Oh, oui. Je vais vous montrer le chemin.</message><message msg_id="2" name_id="99">Hé, vous etes mannequin, par hasard ?&lt;CR&gt;Genre, un modele promotionnel pour ce site touristique ?</message><message msg_id="3" name_id="88">Non, je suis juste une personne ordinaire...</message><message msg_id="4" name_id="98">Vraiment ?&lt;CR&gt;Vous avez une silhouette si parfaite, je pensais que vous étiez une professionnelle.</message></event><event file="event_en/om01/event_message_om01_030.ebm"><message msg_id="0" name_id="91">Mmm... je commence a m'ennuyer de regarder la télé.</message><message msg_id="1" name_id="91">...Il fait beau aujourd'hui. Je me demande si je pourrai voir les étoiles ce soir.</message></event><event file="event_en/om01/event_message_om01_040.ebm"><message msg_id="0" name_id="3">(Je vais peut-etre acheter quelque chose.&lt;CR&gt;Le soda est délicieux par une journée chaude.)</message></event><event file="event_en/om01/event_message_om01_050.ebm"><message msg_id="0" name_id="3">(Le principal veille toujours&lt;CR&gt;sur nous en silence.)</message></event><event file="event_en/om01/event_message_om01_060.ebm"><message msg_id="0" name_id="3">(Le portail de l'école... mais je ne l'ai jamais franchi.&lt;CR&gt;Je suis restée a l'école tout ce temps.)</message></event><event file="event_en/om01/event_message_om01_070.ebm"><message msg_id="0" name_id="3">(Maintenant que j'y pense, il a plu l'autre jour.&lt;CR&gt;Les gouttes de pluie encore posées sur les hortensias sont magnifiques.)</message></event><event file="event_en/om01/event_message_om01_080.ebm"><message msg_id="0" name_id="3">(Les casiers a chaussures. Pour l'instant,&lt;CR&gt;on les utilise pour ranger des chaussures de rechange.)</message></event><event file="event_en/om01/event_message_om01_090.ebm"><message msg_id="0" name_id="3">(C'est surtout Yuki qui s'occupe de la cuisine. Etonnamment, elle reste concentrée&lt;CR&gt;quand elle cuisine, meme si elle se laisse parfois emporter par ses expériences.)</message></event><event file="event_en/om01/event_message_om01_100.ebm"><message msg_id="0" name_id="3">(Les trophées brillent encore de mille feux aujourd'hui.)</message></event><event file="event_en/om01/event_message_om01_110.ebm"><message msg_id="0" name_id="3">(La salle des écrivains. La porte ne bouge pas d'un pouce.&lt;CR&gt;D'ailleurs, c'est quoi, au juste, une salle des écrivains... ?)</message></event><event file="event_en/om01/event_message_om01_120.ebm"><message msg_id="0" name_id="3">(Une salle de classe vide. Tot ou tard, il faudra qu'on réfléchisse a&lt;CR&gt;une bonne facon de l'utiliser.)</message></event><event file="event_en/om01/event_message_om01_130.ebm"><message msg_id="0" name_id="3">(Les toilettes. Si on les garde propres,&lt;CR&gt;la vie s'améliore un peu aussi. C'est comme ca que ca marche.)</message></event><event file="event_en/om01/event_message_om01_140.ebm"><message msg_id="0" name_id="3">(La salle des professeurs. En ce qui concerne cette piece,&lt;CR&gt;c'est peut-etre mieux qu'elle soit fermée a clé...)</message></event><event file="event_en/om01/event_message_om01_150.ebm"><message msg_id="0" name_id="3">(La bibliotheque. Le livre que j'ai lu l'autre jour était intéressant,&lt;CR&gt;alors je vais peut-etre essayer d'en lire un autre.)</message></event><event file="event_en/om01/event_message_om01_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_170.ebm"><message msg_id="0" name_id="3">(Une serviette laissée pres du lavabo&lt;CR&gt;est souvent quelque chose que Yuki a oublié.)</message></event><event file="event_en/om01/event_message_om01_180.ebm"><message msg_id="0" name_id="3">(Les casiers. Gardons tous&lt;CR&gt;l'espace que nous partageons bien propre.)</message></event><event file="event_en/om01/event_message_om01_190.ebm"><message msg_id="0" name_id="3">(On consomme la craie a une vitesse incroyable.&lt;CR&gt;Tout le monde n'arrete pas de dessiner ce qui lui passe par la tete.)</message></event><event file="event_en/om01/event_message_om01_200.ebm"><message msg_id="0" name_id="3">(Le frigo est un sauveur dans ce monde torride.&lt;CR&gt;Il est rempli de poches de glace, de feuilles rafraichissantes et de toutes sortes de choses.)</message></event><event file="event_en/om01/event_message_om01_210.ebm"><message msg_id="0" name_id="3">(Une balance. Monter dessus demande un sacré courage.)</message></event><event file="event_en/om01/event_message_om01_220.ebm"><message msg_id="0" name_id="3">(Les ordinateurs sont d'habitude des mines d'informations personnelles...&lt;CR&gt;mais celui-ci ne contient rien de tel.)</message></event><event file="event_en/om01/event_message_om01_230.ebm"><message msg_id="0" name_id="3">(Une réserve. Si jamais on récupere quelque chose de volumineux,&lt;CR&gt;ce serait peut-etre un bon endroit pour le ranger.)</message></event><event file="event_en/om01/event_message_om01_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_250.ebm"><message msg_id="0" name_id="3">(La salle de diffusion. Si on avait une annonce importante, on utiliserait ca...&lt;CR&gt;En fait, FreeSpace ferait tres bien l'affaire.)</message></event><event file="event_en/om01/event_message_om01_260.ebm"><message msg_id="0" name_id="3">(La salle 2-A. En regardant par la fenetre, elle ressemble a une salle de classe ordinaire.)</message></event><event file="event_en/om01/event_message_om01_270.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_280.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_290.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_300.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_310.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_320.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_330.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_340.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_350.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_360.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_370.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_380.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_390.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_400.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_410.ebm"><message msg_id="4294967295" nam