e="event_en/om02/event_message_om02_850.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_860.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_870.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_880.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_890.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_900.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_910.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_920.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_930.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_940.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_950.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_960.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_970.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_980.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om03"><event file="event_en/om03/event_message_om03_010.ebm"><message msg_id="0" name_id="95">Ooh, ce tamagoyaki a l'air délicieux !</message><message msg_id="1" name_id="87">Héhé, je suis plutot fiere de celui-ci. Tu veux gouter ?</message><message msg_id="2" name_id="95">Hein, je peux ? Attends, tu l'as fait toi-meme ?! Incroyable !&lt;CR&gt;...Mm, c'est délicieux !</message><message msg_id="3" name_id="87">Héhé, merci !</message></event><event file="event_en/om03/event_message_om03_020.ebm"><message msg_id="0" name_id="96">Hé, tu veux qu'on s'arrete quelque part en rentrant ?</message><message msg_id="1" name_id="90">Oh, désolée... je dois aider au magasin.</message><message msg_id="2" name_id="97">Je vois. Ca doit etre dur tous les jours.&lt;CR&gt;Oh, alors peut-etre qu'on passera en tant que clientes.</message><message msg_id="3" name_id="90">Hein ?!&lt;CR&gt;J-je veux bien, mais... c'est un peu genant.</message></event><event file="event_en/om03/event_message_om03_030.ebm"><message msg_id="0" name_id="88">Merci pour tout ce que tu as fait pour moi.</message><message msg_id="1" name_id="56">Quel dommage...&lt;CR&gt;Avec ton talent, tu pourrais viser une scene encore plus grande.</message><message msg_id="2" name_id="88">...Je ne suis pas faite pour ca.&lt;CR&gt;Et puis, j'ai trouvé autre chose que je veux faire.</message></event><event file="event_en/om03/event_message_om03_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om03/event_message_om03_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om03/event_message_om03_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om03/event_message_om03_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om03/event_message_om03_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om03/event_message_om03_090.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</m