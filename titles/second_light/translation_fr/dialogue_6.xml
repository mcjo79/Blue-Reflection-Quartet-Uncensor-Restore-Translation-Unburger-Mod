e_om01_890.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_900.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_910.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_920.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_930.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_940.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_950.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_960.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_970.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_980.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om01/event_message_om01_990.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="om02"><event file="event_en/om02/event_message_om02_010.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_020.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_030.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_040.ebm"><message msg_id="0" name_id="3">(Il y a aussi un distributeur de pain. Les pains alignés a l'intérieur&lt;CR&gt;me semblent a la fois familiers et pourtant inconnus.)</message></event><event file="event_en/om02/event_message_om02_050.ebm"><message msg_id="0" name_id="3">(La salle des professeurs est a l'étage et le bureau du directeur en dessous...&lt;CR&gt;Peut-etre parce que le bureau du directeur est réservé aux visiteurs ?)</message></event><event file="event_en/om02/event_message_om02_060.ebm"><message msg_id="0" name_id="3">(La vue depuis le portail d'entrée est magnifique.&lt;CR&gt;Kokoro s'assoit parfois ici pour regarder le coucher du soleil.)</message></event><event file="event_en/om02/event_message_om02_070.ebm"><message msg_id="0" name_id="3">(Les hortensias fleurissent encore magnifiquement aujourd'hui.&lt;CR&gt;Kokoro et Shiho-san semblent toujours prendre plaisir a s'en occuper.)</message></event><event file="event_en/om02/event_message_om02_080.ebm"><message msg_id="0" name_id="3">(Les casiers a chaussures. L'espace pres de l'entrée se salit facilement,&lt;CR&gt;alors on le nettoie a tour de role environ une fois par semaine.)</message></event><event file="event_en/om02/event_message_om02_090.ebm"><message msg_id="0" name_id="3">(Cette marmite est énorme.&lt;CR&gt;Pour le nombre de personnes qu'on est, une un peu plus petite suffirait.)</message></event><event file="event_en/om02/event_message_om02_100.ebm"><message msg_id="0" name_id="3">(Il y a plein de trophées ici.&lt;CR&gt;Y en a-t-il avec mon nom dessus... ? Bien sur que non !)</message></event><event file="event_en/om02/event_message_om02_110.ebm"><message msg_id="0" name_id="3">(Je ne crois pas que mon école avait une salle des écrivains.&lt;CR&gt;Peut-etre que cette école accorde beaucoup d'efforts a ses clubs culturels ?)</message></event><event file="event_en/om02/event_message_om02_120.ebm"><message msg_id="0" name_id="3">(Une salle de classe vide. Rena-san la surveille de pres&lt;CR&gt;pour s'assurer qu'elle ne se transforme pas en débarras.)</message></event><event file="event_en/om02/event_message_om02_130.ebm"><message msg_id="0" name_id="3">(Les toilettes. Le ménage tourne chaque jour.&lt;CR&gt;Si on le saute, la punition est une semaine entiere de ménage.)</message></event><event file="event_en/om02/event_message_om02_140.ebm"><message msg_id="0" name_id="3">(Meme si je sais qu'il n'y a personne a l'intérieur,&lt;CR&gt;je me redresse naturellement quand je passe devant cette salle...)</message></event><event file="event_en/om02/event_message_om02_150.ebm"><message msg_id="0" name_id="3">(La bibliotheque est un endroit discretement apprécié.&lt;CR&gt;J'y passe des que je veux passer un moment au calme.)</message></event><event file="event_en/om02/event_message_om02_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_170.ebm"><message msg_id="0" name_id="3">(Argh, en regardant de plus pres, j'ai un bouton.&lt;CR&gt;Je vais le cacher avec ma frange.)</message></event><event file="event_en/om02/event_message_om02_180.ebm"><message msg_id="0" name_id="3">(Les casiers. Certains ont du se déformer quelque part,&lt;CR&gt;parce qu'ils sont difficiles a ouvrir.)</message></event><event file="event_en/om02/event_message_om02_190.ebm"><message msg_id="0" name_id="3">(En y repensant, je n'ai jamais vu&lt;CR&gt;Rena-san gribouiller sur le tableau noir...)</message></event><event file="event_en/om02/event_message_om02_200.ebm"><message msg_id="0" name_id="3">(C'est un mystere d'ou vient l'électricité,&lt;CR&gt;mais le réfrigérateur reste froid. Bizarre...)</message></event><event file="event_en/om02/event_message_om02_210.ebm"><message msg_id="0" name_id="3">(La balance ici est analogique.&lt;CR&gt;Voir l'aiguille trembler me rend vraiment nerveuse.)</message></event><event file="event_en/om02/event_message_om02_220.ebm"><message msg_id="0" name_id="3">(J'aimerais bien qu'on puisse regarder des vidéos sur cet ordinateur...)</message></event><event file="event_en/om02/event_message_om02_230.ebm"><message msg_id="0" name_id="3">(Cette réserve contient le matériel utilisé pour le cours de sport.&lt;CR&gt;Soyons prudents chaque fois qu'on l'utilise.)</message></event><event file="event_en/om02/event_message_om02_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_250.ebm"><message msg_id="0" name_id="3">(On s'occupe a tour de role des émissions de l'école.&lt;CR&gt;C'est amusant, mais devoir se lever tot est dur...)</message></event><event file="event_en/om02/event_message_om02_260.ebm"><message msg_id="0" name_id="3">(Cette salle est fermée a clé.&lt;CR&gt;Qu'on me dise que je ne peux pas y entrer ne fait qu'attiser ma curiosité sur ce qu'il y a dedans.)</message></event><event file="event_en/om02/event_message_om02_270.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_280.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_290.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_300.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_310.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_320.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_330.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_340.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_350.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_360.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/om02/event_message_om02_370.ebm"><me