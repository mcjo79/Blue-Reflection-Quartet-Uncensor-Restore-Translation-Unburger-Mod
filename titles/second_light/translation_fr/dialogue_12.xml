event_en/xg06/event_message_xg06_250.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="xg07"><event file="event_en/xg07/event_message_xg07_010.ebm"><message msg_id="4294967295" name_id="1">Oh... ?&lt;CR&gt;Ça a fini par t'intéresser ?</message><message msg_id="4294967295" name_id="1">Je vois, je vois.&lt;CR&gt;J'ai encore plein de choses à te montrer.</message><message msg_id="4294967295" name_id="3">Elle avait l'air bien satisfaite.</message><message msg_id="17423" name_id="12">Quoi d'autre... pourrait-elle vouloir nous montrer... ?</message></event><event file="event_en/xg07/event_message_xg07_020.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_030.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_050.ebm"><message msg_id="4294967295" name_id="1">Ah, te voilà.&lt;CR&gt;Je te cherchais.</message><message msg_id="17072" name_id="3">Hein ?</message><message msg_id="4294967295" name_id="1">Tu aimes les sucreries, pas vrai ?&lt;CR&gt;Allons au dagashiya.</message><message msg_id="17078" name_id="3">E-elle ne s'adressait pas a nous, hein ?&lt;CR&gt;Ca ne devrait etre qu'un souvenir...</message><message msg_id="17422" name_id="12">Elle voulait dire ce dagashiya ?&lt;CR&gt;Allons jeter un oeil.</message></event><event file="event_en/xg07/event_message_xg07_060.ebm"><message msg_id="4294967295" name_id="1">Les champs t'intéressent ?</message><message msg_id="4294967295" name_id="1">Il y a quelque chose d'inhabituel dans le champ, en haut de la colline.</message><message msg_id="17063" name_id="3">En haut de la colline... Elle veut dire ce champ-la ?</message><message msg_id="17437" name_id="12">Je suis curieuse.&lt;CR&gt;On va jeter un oeil ?</message></event><event file="event_en/xg07/event_message_xg07_070.ebm"><message msg_id="4294967295" name_id="1">*Soupir*... Ça ne marche pas, hein...</message><message msg_id="4294967295" name_id="1">...Non. Mamie n'abandonnera pas.</message><message msg_id="17159" name_id="4">C'est étrange...&lt;CR&gt;Elle avait l'air satisfaite il y a un instant.</message><message msg_id="17736" name_id="8">Mais normalement, on ne devrait pas pouvoir&lt;CR&gt;interférer avec ce qu'on voit dans un Heartscape, pas vrai ?</message><message msg_id="17129" name_id="7">C'est censé etre un monde de souvenirs du passé, apres tout.</message><message msg_id="17212" name_id="6">Meme si elle semble réagir a nous,&lt;CR&gt;ca ne doit etre que temporaire.</message><message msg_id="17224" name_id="10">Malgré tout, quelque chose chez cette vieille dame me tracasse.&lt;CR&gt;Elle est partie par la, alors suivons-la !</message></event><event file="event_en/xg07/event_message_xg07_080.ebm"><message msg_id="4294967295" name_id="1">Dis-moi, tu veux quelque chose ?&lt;CR&gt;Je t'achèterai tout ce que tu veux.</message><message msg_id="4294967295" name_id="1">...Je n'ai besoin de rien.</message><message msg_id="4294967295" name_id="1">...Je ne suis pas douée pour ça, hein ?</message><message msg_id="4294967295" name_id="1">Oh... ? Qu'y a-t-il ?</message><message msg_id="17417" name_id="12">Hein... ?</message><message msg_id="4294967295" name_id="1">Tu voulais quelque chose, finalement ?</message><message msg_id="17807" name_id="12">M-moi... ?</message><message msg_id="4294967295" name_id="12">...Alors... des bonbons ramune, s'il te plaît.</message><message msg_id="17074" name_id="3">Elle a disparu ! Et les bonbons ramune ?!</message><message msg_id="17423" name_id="12">C'était quoi, tout ca... ?</message></event><event file="event_en/xg07/event_message_xg07_090.ebm"><message msg_id="17563" name_id="3">Q-quoi ?!</message><message msg_id="4294967295" name_id="1">Il y a quelque chose que je veux te montrer.&lt;CR&gt;Il y a ce navet géant...</message><message msg_id="4294967295" name_id="1">...Pas intéressée.</message><message msg_id="4294967295" name_id="1">...Je vois. Désolée.</message><message msg_id="17063" name_id="3">Un navet géant... C'est ca ?</message><message msg_id="17423" name_id="12">Et si on essayait de le déterrer... ?</message></event><event file="event_en/xg07/event_message_xg07_100.ebm"><message msg_id="4294967295" name_id="1">*Soupir*... Qu'est-ce que je devrais faire ?</message><message msg_id="4294967295" name_id="1">C'est ça ! Tu aimes les poires, pas vrai ?&lt;CR&gt;Allons au verger de poiriers.</message><message msg_id="17078" name_id="3">Maintenant un verger de poiriers... ?</message><message msg_id="17434" name_id="12">On dirait que c'est par la-bas.&lt;CR&gt;Allons jeter un oeil.</message></event><event file="event_en/xg07/event_message_xg07_110.ebm"><message msg_id="4294967295" name_id="1">...</message><message msg_id="4294967295" name_id="1">Je suis sûre que le cœur de —— se trouve quelque part où personne ne peut l'atteindre.</message><message msg_id="4294967295" name_id="1">Mais ce n'est pas grave. Un jour, j'en suis sûre...</message><message msg_id="4294967295" name_id="1">Elle aura une amie qui restera à ses côtés...</message></event><event file="event_en/xg07/event_message_xg07_120.ebm"><message msg_id="4294967295" name_id="1">Regarde toutes ces poires.&lt;CR&gt;Allons en ramasser.</message><message msg_id="4294967295" name_id="1">Je t'éplucherai toutes celles que tu ramasseras.</message><message msg_id="4294967295" name_id="1">...Je n'en veux pas.</message><message msg_id="4294967295" name_id="1">...Ça ne marche pas non plus, hein.</message><message msg_id="17197" name_id="6">Des poires...&lt;CR&gt;Peut-etre que quelque chose changera encore si on ramasse celles qui sont par terre ?</message><message msg_id="17064" name_id="3">Essayons !</message></event><event file="event_en/xg07/event_message_xg07_130.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_160.ebm"><message msg_id="4294967295" name_id="1">Oh là là, tu peux vraiment en manger autant ?</message><message msg_id="17072" name_id="3">Le camion...</message><message msg_id="17423" name_id="12">Il y aurait quelque chose au-dela... ?</message></event><event file="event_en/xg07/event_message_xg07_170.ebm"><message msg_id="4294967295" name_id="3">Des tournesols...</message><message msg_id="4294967295" name_id="1">...Tu les aimes ?</message><message msg_id="4294967295" name_id="12">Je...</message><message msg_id="4294967295" name_id="1">Je les déteste.</message><message msg_id="4294967295" name_id="12">Quoi... ?</message><message msg_id="4294967295" name_id="1">N'est-ce pas ?</message><message msg_id="4294967295" name_id="1">Peu importe ce que tu fais dans ce monde,</message><message msg_id="4294967295" name_id="1">« moi » ne changera pas.</message><message msg_id="17613" name_id="3">Uta-san ?</message><message msg_id="4294967295" name_id="3">Qu'est-ce qui ne va pas ?</message><message msg_id="17410" name_id="12">Non... Ce n'est rien.</message><message msg_id="17564" name_id="3">Q-quoi ?! Qu'est-ce qui se passe ?</message><message msg_id="17104" name_id="7">Regardons autour de nous.</message><message msg_id="17198" name_id="6">Sérieusement... Cet endroit est plein de choses qu'on n'a jamais vues avant.&lt;CR&gt;Qu'est-ce qui se passe avec les souvenirs de Komagawa-san ?</message></event><event file="event_en/xg07/event_message_xg07_180.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_190.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_200.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_210.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_220.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_230.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg07/event_message_xg07_250.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter></dialogue></translation>