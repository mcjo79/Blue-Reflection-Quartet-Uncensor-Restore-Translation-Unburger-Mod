><event file="event_en/xg00/event_message_xg00_130.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_170.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_180.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_190.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_200.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_210.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg00/event_message_xg00_220.ebm"><message msg_id="0" name_id="3">Ils nous ont repérées !&lt;CR&gt;Battons en retraite pour l'instant... !</message></event><event file="event_en/xg00/event_message_xg00_230.ebm"><message msg_id="0" name_id="3">De l'herbe rouge... Peut-etre que je devrais apporter un assaisonnement épicé ?</message></event><event file="event_en/xg00/event_message_xg00_240.ebm"><message msg_id="0" name_id="3">De l'herbe rose... Peut-etre que je devrais apporter un assaisonnement sucré ?</message></event><event file="event_en/xg00/event_message_xg00_250.ebm"><message msg_id="0" name_id="3">De l'herbe jaune... Peut-etre que je devrais apporter un assaisonnement acide ?</message></event></chapter><chapter id="xg01"><event file="event_en/xg01/event_message_xg01_010.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_020.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_030.ebm"><message msg_id="0" name_id="3">Je pense qu'on les a toutes allumées maintenant.</message><message msg_id="1" name_id="4">Peut-etre que le brouillard s'est dissipé ?</message><message msg_id="2" name_id="3">Allons vérifier !</message></event><event file="event_en/xg01/event_message_xg01_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_090.ebm"><message msg_id="0" name_id="3">Ils nous ont repérées !&lt;CR&gt;Battons en retraite pour l'instant... !</message><message msg_id="1" name_id="3">Il faut qu'on se cache mieux.&lt;CR&gt;La prochaine fois, essayons de passer par-dessus les toits ou sous les planchers.</message></event><event file="event_en/xg01/event_message_xg01_100.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_110.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_120.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_130.ebm"><message msg_id="0" name_id="3">Ces monstres ont l'air forts...&lt;CR&gt;Est-ce qu'il y a un moyen de les contourner sans se battre ?</message></event><event file="event_en/xg01/event_message_xg01_140.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_150.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_160.ebm"><message msg_id="0" name_id="3">Ils nous ont repérées !&lt;CR&gt;Battons en retraite pour l'instant... !</message></event><event file="event_en/xg01/event_message_xg01_170.ebm"><message msg_id="0" name_id="3">Ils nous ont repérées !&lt;CR&gt;Battons en retraite pour l'instant... !</message><message msg_id="1" name_id="3">Il faut qu'on se cache mieux.&lt;CR&gt;La prochaine fois, essayons de passer par-dessus les toits ou sous les planchers.</message></event><event file="event_en/xg01/event_message_xg01_180.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_190.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_200.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_210.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_220.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_230.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_240.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg01/event_message_xg01_250.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event></chapter><chapter id="xg02"><event file="event_en/xg02/event_message_xg02_010.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_020.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_030.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_040.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_050.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_060.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_070.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_080.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_090.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_100.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_110.ebm"><message msg_id="4294967295" name_id="3">(Okay, where should I show her first...?)</message><message msg_id="4294967295" name_id="3">(I can't leave out the classroom.&lt;CR&gt;And I should probably show her the workroom where we all eat.)</message><message msg_id="4294967295" name_id="3">(And then... I gave her a quick explanation,&lt;CR&gt;but I should actually show her the Heartscape too.)</message></event><event file="event_en/xg02/event_message_xg02_120.ebm"><message msg_id="4294967295" name_id="3">This is the classroom where we all spend our time.</message><message msg_id="17266" name_id="8">Waouh... C'est vraiment permis d'utiliser une salle de classe comme ca ?</message><message msg_id="17066" name_id="3">C'est bon, c'est bon !&lt;CR&gt;Il n'y a personne ici pour nous voir.</message><message msg_id="17270" name_id="8">Il y a des affaires qui trainent partout...&lt;CR&gt;Ca me donne envie de tout ranger !</message><message msg_id="17092" name_id="3">Je m'en doutais déja un peu, mais...&lt;CR&gt;Shiho, tu es une bonne éleve ?</message><message msg_id="17277" name_id="8">J-je me demande ?&lt;CR&gt;Apres tout, je n'ai aucun souvenir...</message></event><event file="event_en/xg02/event_message_xg02_130.ebm"><message msg_id="17262" name_id="8">C'est... une cuisine ?</message><message msg_id="4294967295" name_id="3">We all call it the workroom.</message><message msg_id="17077" name_id="3">On cuisine et on mange ici,&lt;CR&gt;et on se sert aussi des choses qu'on trouve pour fabriquer des objets.</message><message msg_id="17290" name_id="8">Je vois...</message><message msg_id="17597" name_id="3">...Qu'est-ce qui ne va pas ?</message><message msg_id="17264" name_id="8">Non... Ce n'est rien.&lt;CR&gt;Montre-moi le prochain endroit, s'il te plait !</message></event><event file="event_en/xg02/event_message_xg02_140.ebm"><message msg_id="4294967295" name_id="3">See? The tracks keep going.</message><message msg_id="17262" name_id="8">Donc le Heartscape... se trouve quelque part au-dela ?</message><message msg_id="17089" name_id="3">Ouais.</message><message msg_id="17277" name_id="8">Je me demande pourquoi on est entourées d'eau.</message><message msg_id="4294967295" name_id="3">I don't know... But...</message><message msg_id="17089" name_id="3">Je suis sure que la réponse se trouve au-dela de ces rails.</message></event><event file="event_en/xg02/event_message_xg02_150.ebm"><message msg_id="4294967295" name_id="3">(Let's see, is there anywhere else I should show her...?)</message><message msg_id="17283" name_id="8">Ouf...</message><message msg_id="4294967295" name_id="3">Aah! Giving a proper tour is exhausting!</message><message msg_id="17064" name_id="3">Hé, allons nous amuser un peu.</message><message msg_id="17272" name_id="8">Hein ?</message><message msg_id="17576" name_id="3">Tu veux aller a la cabane de plage ?&lt;CR&gt;C'est la qu'on t'a rencontrée, Shiho.</message><message msg_id="4294967295" name_id="3">Oh, I guess it is technically our secret hideout...</message><message msg_id="4294967295" name_id="8">Secret hideout...</message><message msg_id="17084" name_id="3">Il n'y a personne pour la tenir,&lt;CR&gt;alors on doit préparer les collations nous-memes, par contre...</message><message msg_id="17267" name_id="8">...Hé hé. D'accord.</message><message msg_id="17265" name_id="8">Allons-y.&lt;CR&gt;Moi aussi, ca m'intriguait un peu.</message><message msg_id="17263" name_id="8">Laisse-moi t'inviter pour te remercier de m'avoir fait visiter.</message><message msg_id="17065" name_id="3">Non, c'est plutot a moi de...</message><message msg_id="4294967295" name_id="8">It's all right. I want to do it.</message><message msg_id="17064" name_id="3">Bon, si tu insistes, je vais accepter, alors.</message><message msg_id="17288" name_id="8">Laisse-moi faire !</message></event><event file="event_en/xg02/event_message_xg02_160.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_170.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_180.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_190.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_200.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_210.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_220.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_230.ebm"><message msg_id="4294967295" name_id="4294967295">徃纃宁</message></event><event file="event_en/xg02/event_message_xg02_