{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "br_file_transaction_v1.schema.json",
  "title": "Blue Reflection file transaction journal v1",
  "type": "object",
  "required": [
    "type",
    "format_version",
    "transaction_id",
    "status",
    "created_utc",
    "updated_utc",
    "game_root",
    "transaction_root",
    "selected_modules",
    "files"
  ],
  "properties": {
    "type": {"const": "br_file_transaction"},
    "format_version": {"const": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["prepared", "committing", "committed", "rolling_back", "rolled_back"]
    },
    "created_utc": {"type": "string", "format": "date-time"},
    "updated_utc": {"type": "string", "format": "date-time"},
    "game_root": {"type": "string", "minLength": 1},
    "transaction_root": {"type": "string", "minLength": 1},
    "selected_modules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "original_existed",
          "desired_sha256",
          "staged_path",
          "commit_state",
          "rollback_state"
        ],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "original_existed": {"type": "boolean"},
          "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "desired_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "original_mode": {"type": "integer", "minimum": 0},
          "backup_path": {"type": "string"},
          "staged_path": {"type": "string", "minLength": 1},
          "commit_state": {"enum": ["pending", "committed", "rolled_back"]},
          "rollback_state": {"enum": ["pending", "restored", "removed", "not_needed"]}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
